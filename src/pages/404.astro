---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | Studio Morrow">
  <section class="min-h-[80svh] flex items-center pt-20">
    <div class="wrap text-center">
      <p class="label text-oxblood">404</p>
      <h1 class="display mt-5">Not here</h1>
      <p class="mt-6 text-ink/70">The page you were looking for has moved or never existed.</p>
      <a href="/" class="btn btn-dark mt-9">Back to the studio</a>
    </div>
  </section>
</Base>
